{
  "provider": "anthropic",
  "model": "replace-with-supported-model",
  "model_identity": "provider:model@immutable-revision",
  "base_url": "https://api.anthropic.com",
  "api_key_env": "ANTHROPIC_API_KEY",
  "repetitions": 1,
  "min_request_interval_seconds": 2.0,
  "max_iterations": 12,
  "max_total_tool_calls": 80,
  "max_tool_calls_per_action": 20,
  "verify_timeout_seconds": 120.0
}
